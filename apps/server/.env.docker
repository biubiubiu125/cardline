# 容器内默认配置（Dockerfile 会复制为 /app/apps/server/.env）
# 这些值都会被 docker-compose 的 environment 覆盖，仅作为兜底
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 占位地址，不是生产密码。docker compose 必须用环境变量覆盖。
DATABASE_URL="postgresql://placeholder:placeholder@127.0.0.1:5432/cardline?schema=public"

JWT_SECRET=
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

CORS_ORIGIN=*

PICKUP_CONCURRENCY=4
PICKUP_TIMEOUT_MS=30000
PICKUP_MAX_MESSAGES=30

CARD_PREFIX=CARD
